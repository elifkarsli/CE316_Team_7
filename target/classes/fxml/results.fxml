<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iae.controller.ResultsController">

    <top>
        <VBox spacing="10" style="-fx-padding:16 16 8 16; -fx-background-color:#F7F9FC;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="projectTitleLabel"
                       text="Results"
                       style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#1F3864;"/>
                <Label fx:id="lastRunLabel"
                       text=""
                       style="-fx-font-size:12; -fx-text-fill:#888888;"/>
            </HBox>

            <ToolBar>
                <Button fx:id="runButton"
                        text="Run Project"
                        onAction="#handleRun"
                        style="-fx-background-color:#1F3864; -fx-text-fill:white;
                               -fx-padding:6 16; -fx-background-radius:4;"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="viewDetailsButton"
                        text="View Details"
                        onAction="#handleViewDetails"
                        disable="true"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="summaryLabel" text="" style="-fx-text-fill:#555555;"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <TableView fx:id="resultTable" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </BorderPane.margin>
            <placeholder>
                <Label text="No results yet. Click Run Project to evaluate submissions."
                       style="-fx-text-fill:#888888;"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colStudentId"
                             text="Student ID"
                             minWidth="140" prefWidth="180"/>
                <TableColumn fx:id="colCompileStatus"
                             text="Compile Status"
                             minWidth="120" prefWidth="150"/>
                <TableColumn fx:id="colRunStatus"
                             text="Run Status"
                             minWidth="120" prefWidth="140"/>
                <TableColumn fx:id="colComparison"
                             text="Output Result"
                             minWidth="120" prefWidth="140"/>
                <TableColumn fx:id="colOverall"
                             text="Overall"
                             minWidth="90" prefWidth="100"/>
                <TableColumn fx:id="detailCol"
                             text="Details"
                             minWidth="90" prefWidth="110"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
