<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iae.controller.ResultsController"
            styleClass="screen-shell">

    <top>
        <VBox spacing="20" styleClass="screen-header-wrap">
            <HBox styleClass="surface-card hero-strip" spacing="18">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="projectTitleLabel"
                           text="Results"
                           styleClass="page-title"/>
                    <Label fx:id="lastRunLabel"
                           text=""
                           styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="summaryLabel"
                       text=""
                       styleClass="summary-chip"
                       wrapText="true"/>
            </HBox>

            <HBox styleClass="surface-card toolbar-card" spacing="14" alignment="CENTER_LEFT">
                <Button fx:id="runButton"
                        text="Run Project"
                        onAction="#handleRun"
                        styleClass="primary-button"/>
                <Button fx:id="viewDetailsButton"
                        text="View Details"
                        onAction="#handleViewDetails"
                        disable="true"
                        styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Rows are tinted by outcome and open in a modal detail view."
                       styleClass="toolbar-note" wrapText="true"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="resultTable"
                   BorderPane.alignment="CENTER"
                   styleClass="data-table results-table">
            <BorderPane.margin>
                <Insets top="12" right="18" bottom="18" left="18"/>
            </BorderPane.margin>
            <placeholder>
                <Label text="No results yet. Click Run Project to evaluate submissions."
                       styleClass="empty-state"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colStudentId"
                             text="Student ID"
                             minWidth="150" prefWidth="170"/>
                <TableColumn fx:id="colCompileStatus"
                             text="Compile Status"
                             minWidth="130" prefWidth="150"/>
                <TableColumn fx:id="colRunStatus"
                             text="Run Status"
                             minWidth="130" prefWidth="150"/>
                <TableColumn fx:id="colComparison"
                             text="Output Result"
                             minWidth="140" prefWidth="170"/>
                <TableColumn fx:id="colOverall"
                             text="Overall"
                             minWidth="90" prefWidth="100"/>
                <TableColumn fx:id="detailCol"
                             text="Details"
                             minWidth="90" prefWidth="110"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
